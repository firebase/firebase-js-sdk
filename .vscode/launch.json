{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AI Unit Tests (node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/ai",
      "args": ["run", "--project=node", "--no-file-parallelism"],
      "sourceMaps": true
    },
    {
      "name": "AI Integration Tests (node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/ai",
      "args": [
        "run",
        "--project=node",
        "--no-file-parallelism",
        "integration",
        "-t",
        "${input:grepString}"
      ],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Prune .d.ts",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/repo-scripts/prune-dts",
      "args": ["run", "--testTimeout", "60000", "--no-file-parallelism"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "RTDB Unit Tests (Node)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/database",
      "args": ["run", "--project=node", "--no-file-parallelism"],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Unit Tests (Node)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "run",
        "--project=node",
        "--no-file-parallelism",
        "test/unit",
        "-t",
        "${input:grepString}"
      ],
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Unit Tests (Node / Persistence)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "run",
        "--project=node",
        "--no-file-parallelism",
        "test/unit",
        "-t",
        "${input:grepString}"
      ],
      "env": {
        "USE_MOCK_PERSISTENCE": "YES"
      },
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Integration Tests (Node)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "run",
        "--project=node",
        "--no-file-parallelism",
        "test/integration",
        "-t",
        "${input:grepString}"
      ],
      "env": {
        "FIRESTORE_TARGET_BACKEND": "emulator"
      },
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Integration Tests (Node / Persistence)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "run",
        "--project=node",
        "--no-file-parallelism",
        "test/integration",
        "-t",
        "${input:grepString}"
      ],
      "env": {
        "USE_MOCK_PERSISTENCE": "YES",
        "FIRESTORE_TARGET_BACKEND": "emulator"
      },
      "sourceMaps": true
    },
    {
      "name": "Firestore Enterprise Lite Tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register"],
      "cwd": "${workspaceFolder}/packages/firestore",
      "program": "${workspaceFolder}/packages/firestore/scripts/run-tests.ts",
      "args": [
        "--platform",
        "node_lite",
        "--main=lite/index.ts",
        "test/lite",
        "--grep",
        "${input:grepString}"
      ],
      "env": {
        "TS_NODE_COMPILER_OPTIONS": "{\"module\":\"commonjs\"}",
        "FIRESTORE_TARGET_BACKEND": "nightly",
        "FIRESTORE_TARGET_DB_ID": "enterprise",
        "RUN_ENTERPRISE_TESTS": "true"
      },
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Unit Tests (Browser)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "--project=browser",
        "--browser.headless=false",
        "test/unit",
        "-t",
        "${input:grepString}"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Firestore Integration Tests (Browser)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "cwd": "${workspaceFolder}/packages/firestore",
      "args": [
        "--project=browser",
        "--browser.headless=false",
        "test/integration",
        "-t",
        "${input:grepString}"
      ],
      "env": {
        "FIRESTORE_TARGET_BACKEND": "emulator"
      }
    }
  ],
  "inputs": [
    {
      "id": "grepString",
      "type": "promptString",
      "description": "Enter grep pattern (e.g., 'Google AI gemini-2.0-flash generateContent')",
      "default": ""
    }
  ]
}
