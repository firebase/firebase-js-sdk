{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "importHelpers": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "es2020",
    "lib": ["dom", "es2021"],
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "exclude": [
    "dist/**/*",
    "test/test-inputs/dist/**/*"
  ]
}