{
  "compilerOptions": {
    "outDir": "dist",
    "importHelpers": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "es2020",
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "mocha"]
  },
  "exclude": ["dist/**/*", "tests/**/*.d.ts"]
}
