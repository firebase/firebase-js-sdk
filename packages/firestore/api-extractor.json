{
  /**
   * Configuration for generating the primary reference documentation model (api.json), used by `yarn docgen:devsite`.
   * Note: Rollup .d.ts generation and API review reports are handled by `api-report:*` npm scripts via `repo-scripts/prune-dts`.
   *
   * MULTI-ENTRY-POINT DOCUMENTATION (/lite, /pipelines, /lite/pipelines):
   * Because @microsoft/api-extractor analyzes one entry point per config file, this file only specifies
   * the main entry point (dist/index.d.ts).
   *
   * During devsite generation, scripts/docgen/docgen.ts dynamically runs API Extractor for each secondary
   * entry point and merges their ApiEntryPoint members into `firestore.api.json`.
   */
  "extends": "../../config/api-extractor.json",
  // Point it to your entry point d.ts file.
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "apiReport": {
    /**
     * apiReport is handled by scripts/api-report.ts
     */
    "enabled": false
  }
}
